@{
    ViewData["Title"] = "Weather Map";
}

<div class="weather-map-container">
    <div class="controls-overlay">
        <div class="controls-top">
            <label for="layerSelect" class="control-label">Layer <span class="toggle-handle" onclick="toggleControls()">▾</span></label>
            <select id="layerSelect" onchange="setWeatherLayer(this.value)">
                <option>Temperature</option>
                <option>Clouds</option>
                <option>Precipitation</option>
                <option>Pressure</option>
                <option>Wind</option>
            </select>
        </div>
        <div id="legend" class="legend">
            <strong>Legend</strong>
            <div class="legend-item"><span class="swatch hot"></span> Hot</div>
            <div class="legend-item"><span class="swatch cool"></span> Cool</div>
            <div class="legend-item"><span class="swatch cloud"></span> Clouds</div>
        </div>
    </div>

    <div id="map" class="map"></div>

    <div class="chat-bubble" id="chatBubble" style="display: none;">
        <button class="close-bubble" onclick="hideChatBubble()">✕</button>
        <div class="bubble-content">
            <h4 id="bubbleTitle">Unknown</h4>
            <p id="bubbleWeather"></p>
            <p class="bubble-meta">Layer: <span id="bubbleLayer">Temperature</span></p>
        </div>
    </div>

    <div id="loading" class="loading" style="display:none;">Loading…</div>
</div>

@section scripts {
    <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>

    <script>
        // Initialize map (responsive container)
        let map = L.map('map', { zoomControl: true }).setView([60.1553, -1.1456], 5);
        let marker = null;

        // Base map (OpenStreetMap)
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
        }).addTo(map);

        // Weather overlay (temperature)
        let weatherLayer = L.tileLayer(
            'https://localhost:7022/api/weathermap/tile/temp_new/{z}/{x}/{y}', {
                attribution: '&copy; <a href="https://openweathermap.org/">OpenWeatherMap</a>',
                opacity: 0.5
            }).addTo(map);

        // Layers selector map
        const availableLayers = {
            "Temperature": `temp_new`,
            "Clouds": `clouds_new`,
            "Precipitation": `precipitation_new`,
            "Pressure": `pressure_new`,
            "Wind": `wind_new`
        };

        function setWeatherLayer(layerName) {
            document.getElementById('loading').style.display = 'block';
            if (map.hasLayer(weatherLayer)) {
                map.removeLayer(weatherLayer);
            }
            weatherLayer = L.tileLayer(
                `https://localhost:7022/api/weathermap/tile/${availableLayers[layerName]}/{z}/{x}/{y}`, {
                    attribution: '&copy; <a href="https://openweathermap.org/">OpenWeatherMap</a>',
                    opacity: 0.5
                }
            ).on('load', function() { document.getElementById('loading').style.display = 'none'; })
             .on('tileerror', function() { document.getElementById('loading').style.display = 'none'; });
            weatherLayer.addTo(map);
            document.getElementById('bubbleLayer').textContent = layerName;
        }

        function hideChatBubble() {
            document.getElementById('chatBubble').style.display = 'none';
        }

        // Click event to show location info
        map.on('click', function (e) {
            let lat = e.latlng.lat;
            let lng = e.latlng.lng;
            if (marker) {
                map.removeLayer(marker);
            }
            marker = L.marker([lat, lng]).addTo(map);

            // small UI updates
            document.getElementById('loading').style.display = 'block';

            // Reverse geocoding for location
            fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}&zoom=10`)
                .then(response => response.json())
                .then(data => {
                    let city = data.address.city || data.address.town ||
                        data.address.village || data.address.county ||
                        data.address.state || 'Unknown';
                    let country = data.address.country || 'Unknown';

                    document.getElementById('bubbleTitle').textContent = `${city}, ${country}`;
                    document.getElementById('chatBubble').style.display = 'block';

                    // Fetch live weather (OpenWeatherMap)
                    fetch(`https://localhost:7022/api/weather/current/coordinates?lat=${lat}&lon=${lng}`)
                        .then(response => response.json())
                        .then(weatherData => {
                            const temp = weatherData.main.temp;
                            const desc = weatherData.weather[0].description;
                            const icon = weatherData.weather[0].icon;

                            document.getElementById('bubbleWeather').innerHTML = `<b>${temp}°C</b> — ${desc}`;
                            document.getElementById('bubbleLayer').textContent = document.getElementById('bubbleLayer').textContent;
                            document.getElementById('loading').style.display = 'none';
                        })
                        .catch(err => {
                            console.error('Error fetching weather data:', err);
                            document.getElementById('bubbleWeather').textContent = 'Weather unavailable';
                            document.getElementById('loading').style.display = 'none';
                        });
                })
                .catch(err => {
                    console.error('Error fetching location:', err);
                    document.getElementById('bubbleTitle').textContent = 'Unknown location';
                    document.getElementById('chatBubble').style.display = 'block';
                    document.getElementById('loading').style.display = 'none';
                });
        });

        // Controls collapse/expand behavior
        let controlsCollapsed = false;
        function toggleControls() {
            const c = document.querySelector('.controls-overlay');
            c.classList.toggle('collapsed');
            controlsCollapsed = c.classList.contains('collapsed');
        }
        if (window.innerWidth < 700) {
            const co = document.querySelector('.controls-overlay');
            if (co) { co.classList.add('collapsed'); controlsCollapsed = true; }
        }
    </script>
}
