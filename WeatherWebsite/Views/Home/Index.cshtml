@model dynamic
@{
    ViewData["Title"] = "Home Page";
    var currentWeather = ViewData["CurrentWeather"] as WeatherData;
    var forecast = ViewData["Forecast"] as ForecastData;
    var aqiData = ViewData["AQIData"] as AQIData;
    var selectedLocation = ViewData["SelectedLocation"] as string;
    var selectedTimeZone = ViewData["SelectedTimeZone"] as string;
    var air = aqiData?.List?.FirstOrDefault();
    var aqiLevel = air?.Main?.AQI ?? 0;

    string GetIconSrc(string icon) => $"http://openweathermap.org/img/wn/{icon}@4x.png";

    string GetAQIColor(int aqi) => aqi switch
    {
        1 => "bg-success text-white",
        2 => "bg-warning text-dark",
        3 => "bg-orange text-white",
        4 => "bg-danger text-white",
        5 => "bg-purple text-white",
        _ => "bg-primary text-white"
    };

    string GetAQIStatus(int aqi) => aqi switch
    {
        1 => "Good",
        2 => "Fair",
        3 => "Moderate",
        4 => "Poor",
        5 => "Very Poor",
        _ => "Unknown"
    };
}

<div class="container-fluid py-5">
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <header class="text-center mb-5">
                <h1 class="display-4">Weather Dashboard</h1>
                <p class="lead">Your local weather, updated in real-time.</p>
            </header>

            <form method="post" class="row g-3 align-items-center justify-content-center mb-5">
                <div class="col-auto">
                    <label for="location" class="visually-hidden">Select Location:</label>
                    @Html.DropDownList("selectedLocation", ViewData["Locations"] as SelectList, new { @class = "form-select form-select-lg", @id = "location" })
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary btn-lg">Get Weather</button>
                </div>
            </form>
        </div>
    </div>

    @if (currentWeather != null)
    {
        <div class="row g-4">
            <div class="col-lg-3">
                <div class="card h-100 shadow-sm">
                    <div id="currentWeatherHeader" class="card-header d-flex align-items-center">
                        <div class="row g-2">
                            <h6 class="mb-0">Current Weather in</h6>
                            <h5 class="mb-0">@selectedLocation</h5>
                            <input type="hidden" id="timeZone" value="@selectedTimeZone" />
                            <p class="mb-0"><strong>Current Time:</strong> <span id="currentTime"></span></p>
                        </div>
                    </div>
                    <div class="card-body text-center">
                        <img src="@GetIconSrc(currentWeather.Weather[0].Icon)" alt="@currentWeather.Weather[0].Description" class="img-fluid mb-3" style="width: 120px;">
                        <h2 class="card-title">@currentWeather.Main.Temp.ToString() °C</h2>
                        <p class="card-text text-muted">@currentWeather.Weather[0].Description</p>
                    </div>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item"><strong>Humidity:</strong> @currentWeather.Main.Humidity%</li>
                        <li class="list-group-item"><strong>Wind:</strong> @currentWeather.Wind.Speed m/s</li>
                        <li class="list-group-item"><strong>Pressure:</strong> @currentWeather.Main.Pressure hPa</li>
                        <li class="list-group-item"><strong>Visibility:</strong> @currentWeather.Visibility m</li>
                    </ul>
                    <div class="card-footer text-center">
                        <small class="text-muted">Last updated: @DateTime.Now.ToShortTimeString() (local time)</small>
                    </div>
                </div>
            </div>

            <div class="col-lg-9">
                <div class="card h-100 shadow-sm">
                    <div class="card-header bg-secondary text-white">
                        <h5 class="mb-0">5-Day Forecast</h5>
                    </div>
                    <div class="card-body">
                        <canvas id="temperatureChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        @if (aqiData != null)
        {
            <div class="row mt-4">
                <div class="col-lg-12">
                    <div class="card shadow-sm @GetAQIColor(aqiLevel)">
                        <div class="card-header">
                            <h5 class="mb-0">Air Quality Index (AQI) in @selectedLocation - Status: @GetAQIStatus(aqiLevel)</h5>
                        </div>
                        <div class="card-body">
                            <div class="row text-center">
                                @foreach (var prop in air.Components.GetType().GetProperties())
                                {
                                    <div class="col">
                                        <strong>@prop.Name:</strong>
                                        <p>@prop.GetValue(air.Components) μg/m³</p>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-info text-center" role="alert">
            Please select a location to view the weather information.
        </div>
    }
</div>

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Clock
            function updateTime() {
                const timeZone = document.getElementById('timeZone').value;
                if (!timeZone) return;

                const options = { timeZone: timeZone, hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: true };
                const currentTime = new Date().toLocaleTimeString('en-US', options);
                document.getElementById('currentTime').textContent = currentTime;
            }
            function updateCardColor() {
                const timeZone = document.getElementById('timeZone').value;
                if (!timeZone) return;

                // Get local time in selected timezone
                const now = new Date().toLocaleString('en-US', { timeZone: timeZone });
                const hour = new Date(now).getHours();

                // Decide color class based on local hour
                let colorClass = '';
                let backgroundColor = '';
                let textColor = '';
                if (hour >= 6 && hour < 12) { // Morning
                    backgroundColor = '#87CEEB';
                    textColor = '#000000';
                }
                else if (hour >= 12 && hour < 18) { // Afternoon
                    backgroundColor = '#FFD700';
                    textColor = '#000000';
                }
                else if (hour >= 18 && hour < 24) { // Evening
                    backgroundColor = '#4682B4';
                    textColor = '#FFFFFF';
                }
                else { // Late night
                    backgroundColor = '#000080';
                    textColor = '#FFFFFF';
                }

                // Apply to the Current Weather card header
                const header = document.querySelector('#currentWeatherHeader');
                header.style.backgroundColor = backgroundColor;
                header.style.color = textColor;
                header.className = 'card-header d-flex justify-content-between align-items-center';
            }

            setInterval(() => {
                updateTime();
                updateCardColor();
            }, 1000);
            updateTime();
            updateCardColor();

            // Chart
            if (document.getElementById('temperatureChart')) {
                var ctx = document.getElementById('temperatureChart').getContext('2d');
                var temperatures = @Html.Raw(Json.Serialize(forecast.List.Select(day => day.Main.Temp)));
                var humidityLevels = @Html.Raw(Json.Serialize(forecast.List.Select(day => day.Main.Humidity)));
                var labels = @Html.Raw(Json.Serialize(forecast.List.Select(day => day.DateTimeString)));

                var backgroundColors = temperatures.map(temp => {
                    if (temp < 0) return 'rgba(0, 0, 255, 0.7)';
                    if (temp < 10) return 'rgba(173, 216, 230, 0.7)';
                    if (temp < 20) return 'rgba(255, 255, 0, 0.7)';
                    if (temp < 30) return 'rgba(255, 165, 0, 0.7)';
                    return 'rgba(255, 0, 0, 0.7)';
                });

                new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: labels,
                        datasets: [
                            {
                                label: 'Temperature (°C)',
                                data: temperatures,
                                backgroundColor: backgroundColors,
                                yAxisID: 'y-axis-temp'
                            },
                            {
                                label: 'Humidity (%)',
                                data: humidityLevels,
                                type: 'line',
                                borderColor: 'rgba(54, 162, 235, 1)',
                                backgroundColor: 'rgba(54, 162, 235, 0.2)',
                                yAxisID: 'y-axis-humidity'
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            'y-axis-temp': {
                                beginAtZero: true,
                                position: 'left',
                                title: {
                                    display: true,
                                    text: 'Temperature (°C)'
                                }
                            },
                            'y-axis-humidity': {
                                beginAtZero: true,
                                position: 'right',
                                title: {
                                    display: true,
                                    text: 'Humidity (%)'
                                },
                                grid: {
                                    drawOnChartArea: false
                                }
                            }
                        }
                    }
                });
            }
        });
    </script>
}